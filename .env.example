# Copy to .env and adjust. main.py loads this via python-dotenv.

# Postgres + pgvector connection. Keep the plain postgresql:// form —
# main.py rewrites it to postgresql+psycopg:// at runtime (psycopg v3 driver).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/legal_db

# Vector store collection name. Optional; this is the default.
COLLECTION_NAME=legal_cases
